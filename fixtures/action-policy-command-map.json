{
  "schemaVersion": 1,
  "description": "Machine-readable action policy category contract for pire-browser. Runtime implementation must consume or test against this map before enforcing --action-policy.",
  "categories": [
    "navigate",
    "click",
    "fill",
    "eval",
    "snapshot",
    "scroll",
    "wait",
    "get",
    "interact",
    "state",
    "network",
    "download",
    "upload"
  ],
  "policyShape": {
    "fields": ["default", "allow", "deny"],
    "precedence": ["deny", "allow", "default"],
    "confirmation": "Confirmation is not part of the policy file in v1. It is implemented through the separate --confirm-actions, AGENT_BROWSER_CONFIRM_ACTIONS, confirm, and deny surfaces."
  },
  "resolution": {
    "order": ["compoundEntries", "metaBypasses", "commandEntries", "reservedFutureEntries"],
    "rule": "Compound commands resolve by their special rule first. Exact meta bypasses are checked before policy categories, but a bare-root meta bypass must not shadow a more-specific command entry for the same root. Otherwise, the most-specific command entry wins: root+subcommand or explicit match entries take precedence over root-only entries. Bare roots fall back to root-only entries only when no more specific entry matches. Unsupported or not-available commands keep their existing errors before policy checks.",
    "subcommandRule": "For simple commands, subcommand means the first token after the root. Entries with a match object define signature-specific matching when the meaningful operation token appears later, such as storage local set.",
    "aliasRule": "tab and tabs are aliases and must resolve identically for equivalent forms."
  },
