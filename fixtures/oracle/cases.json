    {
      "id": "negative-stale-ref",
      "description": "A stale or unknown ref fails with a stable error shape.",
      "status": "error",
      "compatibilityItems": [],
      "steps": [
        {
          "id": "open",
          "command": "open {{fixtureUrl}}/form.html"
        },
        {
          "id": "click-stale-ref",
          "command": "click @e404 --json",
          "assertions": [
            {
              "type": "exitCodeNonZero"
            },
            {
              "type": "exitCodeEquals",
              "tool": "pire-browser",
              "value": 44
            },
            {
              "type": "jsonEnvelopeShape",
              "tool": "pire-browser",
              "success": false,
              "errorCode": "ref_stale"
            },
            {
              "type": "outputContains",
              "tool": "pire-browser",
              "value": "ref_stale"
            }
          ]
        }
      ]
    },
