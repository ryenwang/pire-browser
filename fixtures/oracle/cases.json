{
  "schemaVersion": 2,
  "cases": [
    {
      "id": "open-fixture",
      "description": "Open the local fixture and verify both tools land on the same URL/title.",
      "status": "exact",
      "visibleSafe": true,
      "compatibilityItems": [
        {
          "id": "cmd-open",
          "status": "exact",
          "tapeCovered": true
        }
      ],
      "steps": [
        {
          "id": "open",
          "command": "open {{fixtureUrl}}/form.html",
          "assertions": [
            {
              "type": "exitCodeEquals",
              "value": 0
            },
            {
              "type": "urlContains",
              "value": "/form.html"
            },
            {
              "type": "titleContains",
              "value": "pire-browser oracle fixture"
            }
          ]
        }
      ]
    },
    {
      "id": "snapshot-interactive",
      "description": "Interactive snapshot emits refs and key fixture controls.",
      "status": "exact",
      "visibleSafe": true,
      "compatibilityItems": [
        {
          "id": "cmd-snapshot-i",
          "status": "exact",
          "tapeCovered": true
        }
      ],
      "steps": [
        {
          "id": "open",
          "command": "open {{fixtureUrl}}/form.html"
        },
        {
          "id": "snapshot",
          "command": "snapshot -i",
          "assertions": [
            {
              "type": "exitCodeEquals",
              "value": 0
            },
            {
              "type": "stdoutContains",
              "value": "Submit"
            },
            {
              "type": "stdoutContains",
              "value": "Email"
            }
          ],
          "captures": [
            {
              "name": "email",
              "source": "stdout",
              "lineIncludes": [
                "Email"
              ]
            },
            {
              "name": "submit",
              "source": "stdout",
              "lineIncludes": [
                "Submit"
              ]
            }
          ]
        }
      ]
    },
